{
  "schemaVersion": 1,
  "id": "siris",
  "version": "${version}",
  "name": "SIRIS",
  "description": "NVIDIA DLSS Super Resolution and Frame Generation for Minecraft 26.3, in the game's Vulkan renderer, with Vitrail shader packs. Uses the NVIDIA DLSS SDK. Not sponsored or endorsed by NVIDIA. NVIDIA is a trademark of NVIDIA Corporation.",
  "authors": [
    "laurensanp"
  ],
  "contact": {
    "sources": "https://github.com/laurensanp/siris",
    "issues": "https://github.com/laurensanp/siris/issues"
  },
  "license": ["MIT", "LicenseRef-NVIDIA-RTX-SDKs"],
  "icon": "assets/siris/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.siris.Siris"
    ],
    "sodium:config_api_user": [
      "com.siris.SodiumOptions"
    ],
    "modmenu": [
      "com.siris.ModMenuIntegration"
    ]
  },
  "mixins": [
    "siris.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3"
  },
  "breaks": {
    "resolutionscaler": "*"
  },
  "suggests": {
    "modmenu": "*",
    "vitrail": "*"
  }
}
